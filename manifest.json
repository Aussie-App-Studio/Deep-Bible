{
  "manifest_version": 3,
  "name": "Deep Bible: Study Tools for YouVersion (Bible.com)",
  "version": "1.0.2",
  "description": "Transform Bible.com into a Study Bible: commentaries, Strong's lexicon, TSK cross-references, 1-key version switching & parallel.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.bible.com/*",
    "https://moments.youversionapi.com/*",
    "https://aussie-app-studio.github.io/*",
    "https://biblehub.com/*",
    "https://*.enduringword.com/*",
    "https://*.soniclight.com/*",
    "https://*.freebiblecommentary.org/*",
    "https://*.thegospelcoalition.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deep Bible: Study Tools for YouVersion (Bible.com)",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bible.com/*"],
      "js": ["versions.js", "redirect.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bible.com/*"],
      "js": ["bridge_main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bible.com/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "historical.js",
        "sermon_mode.js",
        "fonts/*"
      ],
      "matches": ["https://www.bible.com/*"]
    }
  ]
}
